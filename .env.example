# Example settings for manual or command-line use. Copy this file to ".env" in the folder that contains
# qoyod-mcp.cjs (or the folder above it). Never share or commit your .env: it holds your API keys.
# Each Qoyod company has its own key: Qoyod > Settings > General Settings > API key > Save.

QOYOD_COMPANY_1_NAME=My Company
QOYOD_API_KEY_1=

# Second company (optional). Add _3, _4 ... the same way.
QOYOD_COMPANY_2_NAME=
QOYOD_API_KEY_2=

# ---- optional switches ----------------------------------------------------------------
# Which tool groups exist: all | none | a list of sales, purchases, inventory, accounting
# QOYOD_TOOLSETS=all
# QOYOD_ALLOW_WRITES=all
# QOYOD_ALLOW_DELETES=all
# QOYOD_BLOCK_SALES_WRITES=false
# QOYOD_READ_ONLY=false
#
# Company choice with several companies: pop-up only when no company is named (when_missing),
# or a pop-up for every change (always).
# QOYOD_CONFIRM_WRITES=when_missing
# QOYOD_DEFAULT_COMPANY=
# QOYOD_DEFAULT_WRITE_COMPANY=
#
# Diagnostics: one stderr line per request (never keys or data)
# QOYOD_DEBUG=false
